{
  "name": "groq-lint-editor-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Test files for validating GROQ and schema linting in VS Code, Cursor, and other editors",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:groq": "groq-lint 'src/**/*.ts' --schema schema.json",
    "lint:groq:no-schema": "groq-lint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "devDependencies": {
    "@sanity-labs/groq-lint": "workspace:*",
    "@sanity/icons": "^5.2.3",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "@sanity-labs/eslint-plugin": "workspace:*",
    "prettier": "^3.9.10",
    "@sanity-labs/prettier-plugin-groq": "workspace:*",
    "sanity": "^6.20.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "next-sanity": "^13.3.4"
  }
}
