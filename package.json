{
  "name": "sanity-lint",
  "version": "0.0.0",
  "private": true,
  "description": "Linting tools for Sanity projects",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust-parity": "vitest run --project rust-parity",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/oxlint-config": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/sanity-lint.git"
  },
  "homepage": "https://github.com/sanity-labs/sanity-lint#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/sanity-lint/issues"
  }
}
