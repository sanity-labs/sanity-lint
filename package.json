{
  "name": "sanity-lint",
  "version": "0.0.0",
  "private": true,
  "description": "Linting tools for Sanity projects",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust-parity": "vitest run --project rust-parity",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nkzw/oxlint-config": "^3.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsup": "^9.0.0",
    "turbo": "^2.11.12",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  }
}
