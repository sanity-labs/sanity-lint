{
  "name": "@sanity-labs/groq-lsp",
  "version": "1.0.5",
  "description": "Language Server Protocol implementation for GROQ",
  "author": "Sanity.io <hello@sanity.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/sanity-lint.git",
    "directory": "packages/groq-lsp"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "groq-lsp": "./dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sanity-labs/groq-lint": "workspace:*",
    "@sanity-labs/lint-core": "workspace:*",
    "groq-js": "catalog:",
    "prettier": "^3.9.10",
    "@sanity-labs/prettier-plugin-groq": "workspace:*",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "keywords": [
    "sanity",
    "groq",
    "lsp",
    "language-server"
  ],
  "publishConfig": {
    "access": "public"
  }
}
