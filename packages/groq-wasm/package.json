{
  "name": "@sanity-labs/groq-wasm",
  "version": "1.3.0",
  "description": "WASM bindings for GROQ linting and formatting (groq-lint + groq-format)",
  "keywords": [
    "sanity",
    "groq",
    "lint",
    "format",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": "Sanity.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanity-labs/sanity-lint.git",
    "directory": "packages/groq-wasm"
  },
  "homepage": "https://github.com/sanity-labs/sanity-lint/tree/main/packages/groq-wasm#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/sanity-lint/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    },
    "./lazy": {
      "types": "./dist/index.lazy.d.ts",
      "import": "./dist/index.lazy.js",
      "default": "./dist/index.lazy.js"
    },
    "./wasm": "./wasm/groq_wasm_bg.wasm"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsdown",
    "build:wasm": "./scripts/build-wasm.sh",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sanity-labs/lint-core": "workspace:*",
    "@typescript/typescript6": "^6.0.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
