{
  "name": "@sanity-labs/schema-lint",
  "version": "1.0.5",
  "description": "Schema linting engine and rules for Sanity Lint",
  "author": "Sanity.io <hello@sanity.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/sanity-lint.git",
    "directory": "packages/schema-lint"
  },
  "homepage": "https://github.com/sanity-labs/sanity-lint/tree/main/packages/schema-lint#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/sanity-lint/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sanity-labs/lint-core": "workspace:*"
  },
  "devDependencies": {
    "sanity": "^6.24.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "sanity": ">=3.67.0"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "keywords": [
    "sanity",
    "schema",
    "lint",
    "linter"
  ],
  "publishConfig": {
    "access": "public"
  }
}
